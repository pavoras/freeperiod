<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.0–8.1 cannot restrict backups to device transfer (requireFlags needs API 28),
     so nothing is backed up there. API 28–30: see xml-v28; API 31+: data_extraction_rules. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
